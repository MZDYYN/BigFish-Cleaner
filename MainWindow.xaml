<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CleanC.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CleanC"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="大肥鱼C盘清理工具v0.1">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="28,18,28,10" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="扫描C盘并清理可以安全删除的缓存、日志与残留文件"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
                <Border x:Name="ElevationBadge" CornerRadius="8" Padding="7,1"
                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                        VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="ElevationText" Text="以管理员身份运行" FontSize="11"
                               Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- 磁盘卡片 -->
        <Border Grid.Row="1" Margin="28,0,28,12" Padding="20,16" CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="C:" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="DiskText" VerticalAlignment="Bottom"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ProgressBar x:Name="DiskBar" Maximum="100" Height="8" CornerRadius="4" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="EstimateText" Text="预计可释放 —"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="按当前勾选计算" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 过滤条 -->
        <Grid Grid.Row="2" Margin="28,0,28,8" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Column="0" x:Name="OnlyOldCheck" Content="只清 30 天前未改动的" IsChecked="False" />
            <CheckBox Grid.Column="1" x:Name="ShowCarefulCheck" Content="显示「谨慎」项" IsChecked="True" />
            <CheckBox Grid.Column="2" x:Name="ShowForbiddenCheck" Content="显示「禁止」项" IsChecked="True" />
            <TextBlock Grid.Column="3" x:Name="ScanInfoText" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Grid.Column="4" x:Name="ExportButton" Content="导出报告" />
        </Grid>

        <!-- 分组列表 -->
        <ScrollViewer Grid.Row="3" Margin="28,0,28,0" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="GroupsPanel" Spacing="8" Padding="0,0,0,16" />
        </ScrollViewer>

        <!-- 底部操作 -->
        <Border Grid.Row="4" Padding="28,12,28,16"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="ScanButton" Content="重新扫描" />
                <ProgressRing Grid.Column="1" x:Name="BusyRing" Width="18" Height="18" IsActive="False" />
                <TextBlock Grid.Column="2" x:Name="FooterStatus" VerticalAlignment="Center"
                           Text="准备扫描…" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Grid.Column="3" x:Name="SelectAllButton" Content="全选安全项" />
                <Button Grid.Column="4" x:Name="CleanButton" Content="清理选中" Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</Window>
